---
import Layout from "../layouts/Layout.astro";

export const demoMetadata = {
    href: "/preload",
    number: "04",
    title: "Preload font",
    description:
        'In this example, font faces definitions are loaded from Google Fonts with a stylesheet link, and the main font file (.woff2) is preloaded with rel="preload".',
};
---

<Layout>
    <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
    <link
        slot="head"
        rel="preload"
        href="https://fonts.gstatic.com/s/inter/v20/UcCo3FwrK3iLTcviYwY.woff2"
        as="font"
        type="font/woff2"
        crossorigin
    />
    <link
        slot="head"
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />
    <link
        slot="head"
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
        rel="stylesheet"
    />

    <h1>{demoMetadata.title}</h1>
    <p>{demoMetadata.description}</p>
</Layout>

<style>
    body {
        font-family: "Inter";
    }
</style>
