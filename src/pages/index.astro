---
import Layout from "../layouts/Layout.astro";

type DemoMetadata = {
    href: string;
    number: string;
    title: string;
    badge: string;
    description: string;
};

const demoModules = import.meta.glob<DemoMetadata>(
    "./{inline,partial,links,preload}.astro",
    { eager: true, import: "demoMetadata" },
);
const demos = Object.values(demoModules).sort((a, b) =>
    a.number.localeCompare(b.number),
);
---

<Layout>
    <h1 class="mb-4">Font loading benchmark</h1>

    <section>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
            {demos.map((demo) => (
                <div class="col">
                    <a
                        class="card h-100 text-decoration-none text-body shadow-sm"
                        href={demo.href}
                    >
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <span class="small fw-semibold text-secondary">
                                    {demo.number}
                                </span>
                            </div>
                            <h2 class="h5 card-title fw-bold">{demo.title}</h2>
                            <p class="card-text text-body-secondary">
                                {demo.description}
                            </p>
                            <span class="mt-auto pt-3 fw-semibold link-primary">
                                View demo <span aria-hidden="true">→</span>
                            </span>
                        </div>
                    </a>
                </div>
            ))}
        </div>
    </section>
</Layout>
