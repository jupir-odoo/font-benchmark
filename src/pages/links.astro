---
import Layout from "../layouts/Layout.astro";

export const demoMetadata = {
    href: "/links",
    number: "01",
    badge: "current approach",
    title: "Links",
    description:
        "In this example, font face definitions are loaded from Google Fonts with a stylesheet link. This is the approach recommended by the Google Fonts website.",
    pagespeed:
        "https://pagespeed.web.dev/analysis/https-font-benchmark-netlify-app-links/34yotwggks?form_factor=desktop",
};
---

<Layout>
    <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
    <link
        slot="head"
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />
    <link
        slot="head"
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
        rel="stylesheet"
    />

    <h1>{demoMetadata.title}</h1>
    <p>{demoMetadata.description}</p>
    <p>
        <a href={demoMetadata.pagespeed} target="_blank">
            PageSpeed Insights
        </a>
    </p>
</Layout>

<style>
    body {
        font-family: "Inter";
    }
</style>
